generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Balances {
  id           String   @id
  userId       String
  asset        String
  reserved     Decimal
  available    Decimal
  userId_asset String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id])
}

model Market {
  id                  String                @id
  symbol              String                @unique
  baseAsset           String
  quoteAsset          String
  status              MarketStatus
  tickSize            Decimal
  lotSize             Decimal
  minOrderSize        Decimal
  pricePrecision      Int
  sizePrecision       Int
  makerFeeRate        Decimal
  takerFeeRate        Decimal
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Order               Order[]
  ProtectionDecisions ProtectionDecisions[]
  Trade               Trade[]
}

model Order {
  id                                                          String                @id
  side                                                        OrderSide
  price                                                       Decimal?
  size                                                        Decimal
  remainingSize                                               Decimal
  type                                                        OrderType
  status                                                      OrderStatus
  userId                                                      String
  marketId                                                    String
  createdAt                                                   DateTime              @default(now())
  updatedAt                                                   DateTime
  Market                                                      Market                @relation(fields: [marketId], references: [id])
  User                                                        User                  @relation(fields: [userId], references: [id])
  ProtectionDecisions_ProtectionDecisions_orderIdToOrder      ProtectionDecisions[] @relation("ProtectionDecisions_orderIdToOrder")
  ProtectionDecisions_ProtectionDecisions_takerOrderIdToOrder ProtectionDecisions[] @relation("ProtectionDecisions_takerOrderIdToOrder")
  Trade_Trade_makerOrderIdToOrder                             Trade[]               @relation("Trade_makerOrderIdToOrder")
  Trade_Trade_takerOrderIdToOrder                             Trade[]               @relation("Trade_takerOrderIdToOrder")
}

model ProtectionDecisions {
  id                                            String           @id
  takerOrderId                                  String
  decision                                      DecisionType
  reason                                        ProtectionReason
  priceDeviation                                Decimal?
  quotePrice                                    Decimal?
  quoteAgeMs                                    Int?
  orderId                                       String
  marketId                                      String
  createdAt                                     DateTime         @default(now())
  updatedAt                                     DateTime
  Market                                        Market           @relation(fields: [marketId], references: [id])
  Order_ProtectionDecisions_orderIdToOrder      Order            @relation("ProtectionDecisions_orderIdToOrder", fields: [orderId], references: [id])
  Order_ProtectionDecisions_takerOrderIdToOrder Order            @relation("ProtectionDecisions_takerOrderIdToOrder", fields: [takerOrderId], references: [id])
}

model Trade {
  id                              String   @id
  price                           Decimal
  size                            Decimal
  makerOrderId                    String
  takerOrderId                    String
  marketId                        String
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime
  Order_Trade_makerOrderIdToOrder Order    @relation("Trade_makerOrderIdToOrder", fields: [makerOrderId], references: [id])
  Market                          Market   @relation(fields: [marketId], references: [id])
  Order_Trade_takerOrderIdToOrder Order    @relation("Trade_takerOrderIdToOrder", fields: [takerOrderId], references: [id])
}

model User {
  id        String     @id
  email     String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Balances  Balances[]
  Order     Order[]
  Wallet    Wallet[]
}

model Wallet {
  id        String   @id
  address   String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

enum DecisionType {
  CANCEL
}

enum MarketStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  ACCEPTED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderType {
  LIMIT
  MARKET
}

enum ProtectionReason {
  STRONG_STALE
  DEVIATION
  DEVIATION_HIGH_VOL
  DELAY
  DELAY_HIGH_VOL
}
